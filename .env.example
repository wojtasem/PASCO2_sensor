PASCO2_PORT=COM3
PASCO2_BAUDRATE=9600
PASCO2_MEASUREMENT_INTERVAL_S=5
PASCO2_LOG_LEVEL=INFO

# Opcjonalnie - jesli chcesz zapisywac pomiary do PostgreSQL.
# Jesli zostawisz puste, pomiary beda trzymane tylko w pamieci (tryb dev/demo).
DATABASE_URL=postgresql://postgres:password@localhost:5432/roomco2
