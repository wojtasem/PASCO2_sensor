PASCO2_PORT=COM3
PASCO2_BAUDRATE=9600
# 10s to jedyna wartosc zweryfikowana empirycznie na prawdziwym sensorze
# (patrz docs/protocol-notes.md). Inne wartosci prawdopodobnie zadzialaja,
# ale nie zostaly przetestowane - zweryfikuj scripts/watch_status.py.
PASCO2_MEASUREMENT_INTERVAL_S=10
PASCO2_LOG_LEVEL=INFO

# Opcjonalnie - jesli chcesz zapisywac pomiary do PostgreSQL.
# Jesli zostawisz puste, pomiary beda trzymane tylko w pamieci (tryb dev/demo).
DATABASE_URL=postgresql://postgres:password@localhost:5432/roomco2
